---
/**
 * Header: thin info strip (cities, hours, credentials) + a floating rounded glass "island"
 * with the logo, centered nav, a call pill and the quote button. Island shrinks on scroll.
 */
import logo from '../assets/logo.svg';
import Icon from './Icon.astro';
import { business, nav } from '../config/site';
const path = Astro.url.pathname;
---
<div class="topstrip">
  <div class="wrap topstrip__inner">
    <p><Icon name="pin" />{business.serviceAreas.join(' · ')}</p>
    <p class="topstrip__right">
      <span><Icon name="clock" />Mon–Fri 8–5 · Sat 8–3</span>
      <span><Icon name="shield" />{business.credentials}</span>
    </p>
  </div>
</div>
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="/" aria-label={`${business.shortName} home`}>
      <img src={logo.src} width="150" height="62" alt={business.name} />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
      <span class="sr-only">Menu</span>
      <Icon name="menu" />
    </button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-cta">
      <a class="header-call" href={business.phone.href} data-track="call_click">
        <span class="header-call__ico"><Icon name="phone" /></span>
        <span class="header-call__txt"><small>Call us</small>{business.phone.display}</span>
      </a>
      <a class="btn header-quote" href="/contact/#quote">Get Your Quote <Icon name="arrow" /></a>
    </div>
  </div>
</header>
