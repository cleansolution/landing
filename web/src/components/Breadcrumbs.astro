---
import type { Crumb } from '../lib/schema';
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) =>
      i === items.length - 1
        ? <li><span aria-current="page">{c.name}</span></li>
        : <li><a href={c.href}>{c.name}</a></li>
    )}
  </ol>
</nav>
