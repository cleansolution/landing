---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
import { serviceHref } from '../data/services';
interface Props { items: Service[]; cityName?: string }
const { items, cityName } = Astro.props;
---
<div class="rows">
  {items.map((s) => (
    <article class="row">
      <h3><a href={serviceHref(s.slug)}>{s.name}{cityName ? <span class="sr-only"> in {cityName}</span> : null}</a></h3>
      <p>{s.short}</p>
      <span class="row__go" aria-hidden="true"><Icon name="arrow" /></span>
    </article>
  ))}
</div>
