---
import Base from '../layouts/Base.astro';
import ServiceRows from '../components/ServiceRows.astro';
import { services } from '../data/services';
---
<Base title="Page Not Found | Clean Solutions" description="This page does not exist. Find our cleaning services or request a quote." noindex>
  <section class="section">
    <div class="wrap" style="max-width:860px">
      <span class="eyebrow">Error 404</span>
      <h1>This spot is already clean. There is nothing here.</h1>
      <p class="lead">The page you are looking for does not exist or has moved. Try one of our services or <a href="/contact/#quote">request a quote</a>.</p>
      <h2 style="margin-top:40px">Our cleaning services</h2><ServiceRows items={services} />
    </div>
  </section>
</Base>
