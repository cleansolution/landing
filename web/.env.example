# Copy to .env for local overrides. Never commit real secrets.

# Canonical origin (canonicals, Open Graph, sitemap, robots.txt).
SITE_URL=https://cleansolutionsva.com

# Indexing switch: "true" ONLY in Cloudflare Pages production.
PUBLIC_ALLOW_INDEXING=false

# Form: "demo" (validates, never sends) | "live" (POST /api/contact-message).
PUBLIC_FORM_MODE=demo

# Cloudflare Turnstile site key. Empty = Cloudflare public test key (always passes).
PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4. Empty = nothing loads.
PUBLIC_GA4_ID=
